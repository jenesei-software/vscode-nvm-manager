{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "out",
    "types": ["node", "mocha"]
  },
  "include": ["src/util/**/*.ts", "src/test/**/*.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
