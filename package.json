{
  "name": "nvm-manager",
  "displayName": "NVM Manager",
  "description": "Manage Node.js versions with nvm from VS Code: view installed versions, switch the active one, and auto-switch per project via .nvmrc.",
  "version": "1.1.0",
  "publisher": "jenesei-software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jenesei-software/vscode-nvm-manager"
  },
  "bugs": {
    "url": "https://github.com/jenesei-software/vscode-nvm-manager/issues"
  },
  "homepage": "https://github.com/jenesei-software/vscode-nvm-manager#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "NVM Manager executes the nvm CLI and reads version files from the workspace. In untrusted workspaces it shows information but does not auto-switch, install or probe anything declared by project files."
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "nvm",
    "nvm-windows",
    "node",
    "nodejs",
    "version manager"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.nvmrc"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nvmManager",
          "title": "NVM Manager",
          "icon": "resources/nvm.svg"
        }
      ]
    },
    "views": {
      "nvmManager": [
        {
          "id": "nvmManager.project",
          "name": "Project",
          "icon": "resources/nvm.svg"
        },
        {
          "id": "nvmManager.versions",
          "name": "Versions",
          "icon": "resources/nvm.svg"
        },
        {
          "id": "nvmManager.settings",
          "name": "Settings",
          "type": "webview",
          "icon": "resources/nvm.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nvmManager.refresh",
        "title": "Refresh",
        "category": "NVM",
        "icon": "$(refresh)"
      },
      {
        "command": "nvmManager.switch",
        "title": "Switch Node.js Version...",
        "category": "NVM",
        "icon": "$(versions)"
      },
      {
        "command": "nvmManager.use",
        "title": "Use This Version",
        "category": "NVM"
      },
      {
        "command": "nvmManager.install",
        "title": "Install Version",
        "category": "NVM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nvmManager.uninstall",
        "title": "Uninstall Version",
        "category": "NVM"
      },
      {
        "command": "nvmManager.copyVersion",
        "title": "Copy Version",
        "category": "NVM"
      },
      {
        "command": "nvmManager.refreshRemote",
        "title": "Refresh Available Versions",
        "category": "NVM"
      },
      {
        "command": "nvmManager.toggleAutoSwitchGlobal",
        "title": "Toggle Auto-switch (Global)",
        "category": "NVM"
      },
      {
        "command": "nvmManager.switchToDeclared",
        "title": "Switch to Project Version",
        "category": "NVM",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "nvmManager.installDeclared",
        "title": "Install Project Version",
        "category": "NVM",
        "icon": "$(cloud-download)"
      },
      {
        "command": "nvmManager.checkPackages",
        "title": "Check Package Manager Availability",
        "category": "NVM"
      },
      {
        "command": "nvmManager.pinVersion",
        "title": "Pin Active Version to Project",
        "category": "NVM",
        "icon": "$(pin)"
      },
      {
        "command": "nvmManager.toggleAutoSwitchWorkspace",
        "title": "Toggle Auto-switch (This Project)",
        "category": "NVM"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nvmManager.switch",
          "when": "view == nvmManager.versions",
          "group": "navigation@1"
        },
        {
          "command": "nvmManager.pinVersion",
          "when": "view == nvmManager.project",
          "group": "navigation@1"
        },
        {
          "command": "nvmManager.refresh",
          "when": "view == nvmManager.versions || view == nvmManager.project",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "nvmManager.switchToDeclared",
          "when": "view == nvmManager.project && viewItem == projectActiveDiffers",
          "group": "inline@1"
        },
        {
          "command": "nvmManager.installDeclared",
          "when": "view == nvmManager.project && viewItem == projectNoMatch",
          "group": "inline@1"
        },
        {
          "command": "nvmManager.use",
          "when": "view == nvmManager.versions && viewItem == installed",
          "group": "inline@1"
        },
        {
          "command": "nvmManager.copyVersion",
          "when": "view == nvmManager.versions && viewItem == installed",
          "group": "inline@2"
        },
        {
          "command": "nvmManager.uninstall",
          "when": "view == nvmManager.versions && viewItem == installed",
          "group": "1_manage@1"
        },
        {
          "command": "nvmManager.copyVersion",
          "when": "view == nvmManager.versions && viewItem == active",
          "group": "inline@1"
        },
        {
          "command": "nvmManager.uninstall",
          "when": "view == nvmManager.versions && viewItem == active",
          "group": "1_manage@1"
        },
        {
          "command": "nvmManager.install",
          "when": "view == nvmManager.versions && viewItem == remote",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "nvmManager.use",
          "when": "false"
        },
        {
          "command": "nvmManager.install",
          "when": "false"
        },
        {
          "command": "nvmManager.uninstall",
          "when": "false"
        },
        {
          "command": "nvmManager.copyVersion",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "NVM Manager",
      "properties": {
        "nvmManager.nvmPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Windows only. Absolute path to `nvm.exe`. Leave empty to auto-detect from `NVM_HOME` or `PATH`."
        },
        "nvmManager.nvmDir": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "macOS / Linux only. Path to the nvm directory (`NVM_DIR`). Leave empty to auto-detect from `NVM_DIR` or `~/.nvm`."
        },
        "nvmManager.autoSwitch": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Auto-switch the active Node.js version from `.nvmrc` / `.node-version` / `package.json` `engines.node` when a workspace is opened. Set globally or per workspace."
        },
        "nvmManager.askWhenAutoSwitchOff": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Ask before switching when auto-switch is disabled."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "node esbuild.mjs",
    "build:watch": "node esbuild.mjs --watch",
    "build:prod": "node esbuild.mjs --production",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check:registry": "node scripts/check-registry.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:registry",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/*.test.js\"",
    "pretest:integration": "npm run build:prod && tsc -p tsconfig.test.json",
    "test:integration": "vscode-test",
    "vsix": "vsce package",
    "vsix:publish": "vsce publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.2"
  }
}
